#!/bin/sh
# No hot microphone recording or sound playback at boot.
# Existing rvd/rad/rac/RTSP services remain managed by the base camera image.
case "${1:-}" in
  start)
    mkdir -p /run
    printf 'camera-head helper overlay started\n' > /run/wifcam-helper-booted
    ;;
  stop)
    rm -f /run/wifcam-helper-booted
    ;;
  restart)
    rm -f /run/wifcam-helper-booted
    mkdir -p /run
    printf 'camera-head helper overlay started\n' > /run/wifcam-helper-booted
    ;;
  *) echo "Usage: $0 {start|stop|restart}" >&2; exit 2 ;;
esac
