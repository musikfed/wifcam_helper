#!/bin/sh
# No hot microphone, speaker or PTZ action at boot.
case "$1" in
  start|restart)
    /usr/bin/wifcam-helper-mode init >/dev/null || exit 1
    mkdir -p /run
    printf 'ready\n' > /run/wifcam-helper-booted
    ;;
  stop) rm -f /run/wifcam-helper-booted ;;
  *) echo "Usage: $0 {start|stop|restart}" >&2; exit 2 ;;
esac
